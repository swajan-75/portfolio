DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"
PRISMA_DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# JWT Configuration
JWT_SECRET="change_me"
JWT_EXPIRES_IN="1d"

# Email Configuration for OTP
SMTP_USER="you@example.com"
SMTP_PASS="app_password_here"
SMTP_FROM="you@example.com"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:8000/api/v1/auth/google/callback"

# --- Added for the frontend API build-out (cookie auth, uploads, tracking) ---
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
VISITOR_HASH_SALT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run seed` to set the initial admin password (bcrypt-hashed
# before it's stored) — never read by the running app itself.
ADMIN_SEED_PASSWORD="change_me"
