// ─────────────────────────────────────────────
// CV / resume files
// ─────────────────────────────────────────────

model Cv {
  id                 String   @id @default(cuid())
  name               String
  url                String
  cloudinaryPublicId String?
  active             Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@map("cvs")
}

// ─────────────────────────────────────────────
// Analytics
// ─────────────────────────────────────────────

model VisitLog {
  id        String   @id @default(cuid())
  visitorId String   // sha256(ip + salt) — never a raw IP
  country   String?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([country])
  @@map("visit_logs")
}

model DownloadLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@map("download_logs")
}

// ─────────────────────────────────────────────
// Admin Authentication
// ─────────────────────────────────────────────

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // Hashed password
  googleId  String?  // For Google OAuth
  otp       String?  // Hashed OTP or plain OTP based on security needs (we'll store plain/hashed)
  otpExpiry DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}